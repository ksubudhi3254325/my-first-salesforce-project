<!-- WrapperComponent.cmp -->
<aura:component implements="flexipage:availableForAllPageTypes" description="Main container layout holding sibling components">
    
    <div class="slds-box slds-theme_default slds-m-around_medium">
        <!-- Header for the page container -->
        <div class="slds-page-header slds-m-b_medium">
            <h1 class="slds-page-header__title">Application Event Demo Dashboard</h1>
            <p class="slds-text-body_label">Demonstrating data transfer between sibling components</p>
        </div>
        
        <!-- Responsive layout grid using Salesforce Lightning Design System (SLDS) -->
        <div class="slds-grid slds-wrap slds-gutters">
            
            <!-- Left Column: Holds the Sender Component -->
            <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-2 slds-m-bottom_medium">
                <c:SenderComponent />
            </div>
            
            <br/><hr/><br/>
            
            <!-- Right Column: Holds the Receiver Component -->
            <div class="slds-col slds-size_1-of-1 slds-medium-size_1-of-2">
                <c:ReceiverComponent />
            </div>
            
        </div>
    </div>
    
</aura:component>
<aura:component >
    <aura:attribute name="Var1" type="String" default="Test value"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
   
    <aura:attribute name="newAcc" type="Account" 
                    default="{'sobjType' : 'Account',
                             'Name' : 'TestAcc1'}"/>
    
    <aura:attribute name="students" type="String[]" 
                    default="['Ram', 'Shyam']"/>
    
    <aura:attribute name="listDemo" type="List" 
                    default="['List1', 'List2']"/>
    
    <aura:attribute name="setDemo" type="Set" 
                    default="['Set1', 'Set2']"/>
    
    <aura:attribute name="mapDemo" type="Map" 
                    default="{a:'Map1', b:'Map2', c:'Map3'}"/>
   
    <aura:attribute name="jsObject" type="Object"/>
   
    <aura:attribute name="userDate" type="LCDemoWrapper.WrapperTest"/>
   
    <h1>
    	Attribute value: {!v.Var1}<br/>
        {!v.newAcc.Name}<br/>
        {!v.students[0]}<br/>
        {!v.listDemo[1]}<br/>
        {!v.setDemo[0]}<br/>
        Map Value: {!v.mapDemo.b}<h1/>
        
        Length of list: {!v.listDemo.length}
        <hr/>
        jsobject value = {!v.jsObject.name} - {!v.jsObject.email}
        
        <h1/>
        Wrapper Value : {!v.userDate.myString1} - {!v.userDate.myInteger1}
           
        
        
    </h1>
</aura:component>
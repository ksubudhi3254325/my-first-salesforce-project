<aura:component >
    <aura:attribute name="parentVar" type="String" default="Parent Value"/>
    
    <c:unBoundedChild childVar="{#v.parentVar}"/>
    
    Parent value: {!v.parentVar}
    
    <br/><lightning:button label="Update parent value" onclick="{!c.updateParentVar}"/>
    
</aura:component>